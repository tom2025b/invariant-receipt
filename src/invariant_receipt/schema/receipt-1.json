{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "invariant-receipt/receipt/1",
  "title": "Invariant Receipt — one mutation",
  "description": "Evidence and verdict for one explicit mutation of one invariant. Optional fields may be added within version 1; renaming or removing a field is a new version.",
  "type": "object",
  "required": ["schema", "tool", "invariant", "test", "expect", "source", "runner", "baseline", "mutation", "verdict", "reason", "reason_detail", "started_at", "finished_at"],
  "properties": {
    "schema": {"const": "invariant-receipt/receipt/1"},
    "tool": {"$ref": "#/$defs/tool"},
    "invariant": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "test": {"type": "string", "minLength": 1},
    "expect": {
      "type": "object",
      "required": ["outcome", "matches"],
      "properties": {
        "outcome": {"const": "fail"},
        "matches": {"type": ["string", "null"]}
      }
    },
    "source": {
      "type": "object",
      "required": ["repo", "repo_commit", "project", "tree_clean_before", "tree_status_before", "tree_hash_before", "tree_clean_after", "tree_status_after", "tree_hash_after", "tree_unchanged"],
      "properties": {
        "repo": {"type": "string"},
        "repo_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "project": {"type": "string"},
        "tree_clean_before": {"type": "boolean"},
        "tree_status_before": {"type": "array", "items": {"type": "string"}},
        "tree_hash_before": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tree_clean_after": {"type": ["boolean", "null"]},
        "tree_status_after": {"type": ["array", "null"], "items": {"type": "string"}},
        "tree_hash_after": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "tree_unchanged": {"type": ["boolean", "null"]}
      }
    },
    "runner": {
      "type": "object",
      "required": ["requested", "kind", "parser"],
      "properties": {
        "requested": {"enum": ["auto", "pytest", "nextest", "cargo"]},
        "kind": {"enum": ["pytest", "nextest", "cargo", null]},
        "parser": {"enum": ["junit-xml", "nextest-junit", "cargo-text", null]},
        "version": {"type": ["string", "null"]},
        "target": {"type": ["string", "null"]}
      }
    },
    "baseline": {
      "type": "object",
      "required": ["repeat", "compile", "runs", "status"],
      "properties": {
        "repeat": {"type": "integer", "minimum": 1},
        "compile": {"$ref": "#/$defs/compile"},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
        "status": {"enum": ["green", "not_green", "not_run"]}
      }
    },
    "mutation": {
      "type": "object",
      "required": ["id", "kind", "fingerprint", "applied", "changed", "apply_detail", "compile", "run"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": ["string", "null"]},
        "kind": {"enum": ["find_replace", "patch"]},
        "file": {"type": ["string", "null"]},
        "find": {"type": ["string", "null"]},
        "replace": {"type": ["string", "null"]},
        "patch": {"type": ["string", "null"]},
        "patch_sha256": {"type": ["string", "null"]},
        "fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "diff": {"type": ["string", "null"]},
        "applied": {"type": ["boolean", "null"]},
        "changed": {"type": ["boolean", "null"]},
        "apply_detail": {"type": "string"},
        "compile": {"$ref": "#/$defs/compile"},
        "run": {
          "oneOf": [
            {"type": "null"},
            {
              "allOf": [
                {"$ref": "#/$defs/run"},
                {
                  "type": "object",
                  "required": ["named_test_observed", "named_test_result", "oracle_matched", "failure_signature", "failure_signature_kind", "failure_signature_basis", "failure_excerpt"],
                  "properties": {
                    "named_test_observed": {"type": "boolean"},
                    "named_test_result": {"$ref": "#/$defs/named_result"},
                    "oracle_matched": {"type": ["boolean", "null"]},
                    "failure_signature": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
                    "failure_signature_kind": {"enum": ["location", "message-normalised", null]},
                    "failure_signature_basis": {"type": ["string", "null"]},
                    "failure_excerpt": {"type": ["string", "null"]}
                  }
                }
              ]
            }
          ]
        }
      }
    },
    "verdict": {"enum": ["CAUGHT", "SURVIVED", "INVALID", "UNKNOWN"]},
    "reason": {"type": "string"},
    "reason_detail": {"type": "string"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "CAUGHT"}}}, "then": {"properties": {"reason": {"const": "caught"}, "mutation": {"properties": {"run": {"type": "object", "properties": {"named_test_result": {"const": "failed"}, "oracle_matched": {"const": true}}}}}}}},
    {"if": {"properties": {"verdict": {"const": "SURVIVED"}}}, "then": {"properties": {"reason": {"const": "named_test_passed"}, "mutation": {"properties": {"run": {"type": "object", "properties": {"named_test_result": {"const": "passed"}}}}}}}},
    {"if": {"properties": {"verdict": {"const": "INVALID"}}}, "then": {"properties": {"reason": {"enum": ["baseline_not_stable", "baseline_no_tests", "named_test_not_found", "mutation_not_applied", "mutation_no_change", "compile_failed", "collection_failed", "zero_tests", "named_test_not_observed", "timeout", "oracle_mismatch"]}}}},
    {"if": {"properties": {"verdict": {"const": "UNKNOWN"}}}, "then": {"properties": {"reason": {"enum": ["runner_missing", "copy_failed", "internal_error", "source_tree_changed"]}}}},
    {"if": {"properties": {"verdict": {"enum": ["CAUGHT", "SURVIVED", "INVALID"]}}}, "then": {"properties": {"source": {"properties": {"tree_unchanged": {"const": true}}}}}}
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version", "commit", "build_time", "build", "dirty"],
      "properties": {
        "name": {"const": "invariant-receipt"},
        "version": {"type": "string"},
        "commit": {"type": "string"},
        "build_time": {"type": ["string", "null"]},
        "build": {"enum": ["installed", "source"]},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "compile": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["ok", "failed", "timeout", "skipped", "not_run"]},
        "command": {"type": ["array", "null"], "items": {"type": "string"}},
        "exit": {"type": ["integer", "null"]},
        "seconds": {"type": ["number", "null"]},
        "detail": {"type": "string"},
        "log": {"type": ["string", "null"]}
      }
    },
    "named_result": {"enum": ["passed", "failed", "skipped", "error", "timeout", "not_observed", "ambiguous"]},
    "run": {
      "type": "object",
      "required": ["command", "exit", "timed_out", "seconds", "parser", "discovered", "passed", "failed", "skipped", "errors", "named_test", "log"],
      "properties": {
        "command": {"type": "array", "items": {"type": "string"}},
        "exit": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "seconds": {"type": "number"},
        "parser": {"enum": ["junit-xml", "nextest-junit", "cargo-text"]},
        "parse_error": {"type": ["string", "null"]},
        "collection_error": {"type": ["string", "null"]},
        "ambiguous_harness_output": {"type": ["string", "null"]},
        "discovered": {"type": ["integer", "null"], "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "named_test": {"$ref": "#/$defs/named_result"},
        "named_test_matches": {"type": "integer", "minimum": 0},
        "notes": {"type": "array", "items": {"type": "string"}},
        "log": {"type": ["string", "null"]},
        "output_tail": {"type": "string"}
      }
    }
  }
}
